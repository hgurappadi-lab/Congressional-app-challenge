# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must NEVER be committed.

# Supabase project URL and public (anon) key.
# Safe to expose to the browser — protected by Row Level Security policies,
# not by secrecy. Found in Supabase dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key.
# SERVER-SIDE ONLY. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_,
# never import it into client-side code, never commit it. Used only by
# scripts/seed-*.js and any privileged server-side API routes.
SUPABASE_SERVICE_ROLE_KEY=

# No map API key needed — the interactive map (src/components/RestaurantMap.js)
# uses Leaflet with OpenStreetMap tiles, which are free and don't require an
# API key or account. See ARCHITECTURE.md's "Map integration" section.

# Anthropic API key (console.anthropic.com), used ONLY by
# src/app/api/website-lookup/route.js for the on-demand "check this
# restaurant's website with AI" feature. SERVER-SIDE ONLY — never prefix
# with NEXT_PUBLIC_. Paid API, billed per lookup; not required for the rest
# of the app to work. See LIMITATIONS.md for the scoring boundary this
# feature stays behind.
ANTHROPIC_API_KEY=

# Google Places API key (console.cloud.google.com), used for finding
# nearby restaurants outside the curated dataset (src/lib/google-places.js,
# /api/nearby-live, scripts/find-restaurant-candidates.js).
# Requires "Places API (New)" enabled on the project, plus billing — this
# is a paid API, unlike the free OpenStreetMap discovery it replaced. See
# ARCHITECTURE.md. SERVER-SIDE ONLY — never prefix with NEXT_PUBLIC_.
GOOGLE_PLACES_API_KEY=
