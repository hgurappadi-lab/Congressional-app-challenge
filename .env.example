# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must NEVER be committed.

# Supabase project URL and public (anon) key.
# Safe to expose to the browser — protected by Row Level Security policies,
# not by secrecy. Found in Supabase dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key.
# SERVER-SIDE ONLY. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_,
# never import it into client-side code, never commit it. Used only by
# scripts/seed-*.js and any privileged server-side API routes.
SUPABASE_SERVICE_ROLE_KEY=

# Google Maps JavaScript API key, restricted to:
#   - HTTP referrer restriction (your deployed domain + localhost for dev)
#   - "Maps JavaScript API" only (no Places/Geocoding/other APIs enabled for this key)
# This key is exposed to the browser by design (map rendering requires it
# client-side) — the referrer + API restrictions are what keep it safe, not secrecy.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
